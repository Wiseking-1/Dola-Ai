<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dola AI — IBRAHIM ABDULLAHI 🇳🇬</title>

    <!-- Tailwind + Font Awesome + Google Font -->
    <script src="https://cdn.tailwindcss.com">
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />

    <style>
        /* ----- RESET / BASE ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: #0b0d10;
            color: #e8edf2;
            height: 100vh;
            overflow: hidden;
        }
        ::-webkit-scrollbar {
            width: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #1a1e24;
        }
        ::-webkit-scrollbar-thumb {
            background: #3b424b;
            border-radius: 6px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #5a6470;
        }

        /* ----- SIDEBAR ----- */
        .sidebar {
            width: 280px;
            min-width: 280px;
            background: #13171c;
            border-right: 1px solid #262c33;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            position: relative;
            transition: transform 0.25s ease;
        }
        .sidebar-header {
            padding: 16px 18px 12px 18px;
            border-bottom: 1px solid #262c33;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }
        .sidebar-header .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 18px;
            color: #f0c27f;
            letter-spacing: -0.3px;
        }
        .sidebar-header .brand i {
            font-size: 22px;
            color: #f0c27f;
        }
        .sidebar-header .home-btn {
            background: #1f262e;
            border: none;
            color: #bcc8d6;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: 0.2s;
        }
        .sidebar-header .home-btn:hover {
            background: #2c353f;
            color: #f0c27f;
        }

        .sidebar-title {
            padding: 14px 18px 6px 18px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6a7a8a;
            flex-shrink: 0;
        }

        .chat-list {
            flex: 1;
            overflow-y: auto;
            padding: 4px 0 12px 0;
        }
        .chat-item {
            padding: 12px 16px;
            margin: 4px 8px;
            border-radius: 10px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: background 0.15s;
            position: relative;
            gap: 8px;
            min-height: 52px;
        }
        .chat-item:hover {
            background: #1e252d;
        }
        .chat-item.active {
            background: #1e2a33;
            border-left: 3px solid #f0c27f;
            padding-left: 13px;
        }
        .chat-item .chat-title {
            font-size: 15px;
            font-weight: 500;
            color: #dce4ec;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex: 1;
            min-width: 0;
        }
        .chat-item .chat-title .date {
            font-size: 11px;
            font-weight: 400;
            color: #6a7a8a;
            margin-left: 8px;
            white-space: nowrap;
        }
        .chat-item .dot-menu-btn {
            background: transparent;
            border: none;
            color: #b0b0b0;
            font-size: 18px;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
            transition: background 0.15s;
            line-height: 1;
        }
        .chat-item .dot-menu-btn:hover {
            background: #2c353f;
            color: #e8edf2;
        }

        .dropdown-menu {
            position: absolute;
            right: 0;
            top: 38px;
            background: #1e252d;
            border: 1px solid #2f3842;
            border-radius: 12px;
            padding: 6px 0;
            min-width: 170px;
            z-index: 999;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.7);
            display: none;
            overflow: hidden;
        }
        .dropdown-menu.open {
            display: block;
        }
        .dropdown-menu .drop-item {
            padding: 10px 18px;
            font-size: 14px;
            color: #dce4ec;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: background 0.1s;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
            font-weight: 450;
        }
        .dropdown-menu .drop-item:hover {
            background: #2c353f;
        }
        .dropdown-menu .drop-item i {
            width: 18px;
            font-size: 14px;
            color: #9aabbb;
        }
        .dropdown-menu .drop-item.danger {
            color: #f28b82;
        }
        .dropdown-menu .drop-item.danger i {
            color: #f28b82;
        }

        .rename-inline {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
            min-width: 0;
        }
        .rename-inline input {
            background: #0b0d10;
            border: 1px solid #2f3842;
            border-radius: 6px;
            padding: 4px 10px;
            color: #e8edf2;
            font-size: 14px;
            flex: 1;
            min-width: 0;
            outline: none;
        }
        .rename-inline input:focus {
            border-color: #f0c27f;
        }
        .rename-inline .rename-btn {
            background: transparent;
            border: none;
            color: #9aabbb;
            cursor: pointer;
            font-size: 14px;
            padding: 4px 6px;
            border-radius: 4px;
            transition: 0.15s;
        }
        .rename-inline .rename-btn:hover {
            color: #f0c27f;
            background: #1f262e;
        }
        .rename-inline .rename-btn.save {
            color: #7ddfa0;
        }
        .rename-inline .rename-btn.save:hover {
            background: #1a2a22;
        }
        .rename-inline .rename-btn.cancel {
            color: #f28b82;
        }
        .rename-inline .rename-btn.cancel:hover {
            background: #2a1e1e;
        }

        /* ----- CHAT AREA ----- */
        .chat-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: #0b0d10;
            min-width: 0;
            height: 100vh;
            overflow: hidden;
        }
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px 24px 12px 24px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .msg {
            max-width: 85%;
            padding: 12px 16px;
            border-radius: 16px;
            font-size: 15px;
            line-height: 1.6;
            position: relative;
            word-wrap: break-word;
            animation: fadeIn 0.2s ease;
            transition: background 0.15s;
        }
        .msg.user {
            align-self: flex-end;
            background: #1a2a33;
            border-bottom-right-radius: 4px;
        }
        .msg.ai {
            align-self: flex-start;
            background: #161b22;
            border-bottom-left-radius: 4px;
        }
        .msg .msg-time {
            font-size: 10px;
            color: #6a7a8a;
            margin-top: 4px;
            display: block;
            text-align: right;
        }
        .msg .msg-image {
            max-width: 220px;
            max-height: 220px;
            border-radius: 12px;
            margin: 6px 0 8px 0;
            cursor: pointer;
            border: 1px solid #262c33;
            display: block;
            object-fit: contain;
            background: #0b0d10;
        }

        .msg-actions {
            display: none;
            gap: 4px;
            margin-top: 6px;
            flex-wrap: wrap;
        }
        .msg:hover .msg-actions,
        .msg-actions.force-show {
            display: flex;
        }
        .msg-actions .act-btn {
            background: #1f262e;
            border: none;
            color: #b0c0ce;
            font-size: 13px;
            padding: 4px 10px;
            border-radius: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: 0.15s;
            white-space: nowrap;
        }
        .msg-actions .act-btn:hover {
            background: #2c353f;
            color: #e8edf2;
        }
        .msg-actions .act-btn.edit {
            color: #7ddfa0;
        }
        .msg-actions .act-btn.edit:hover {
            background: #1a2a22;
        }
        .msg-actions .act-btn.danger {
            color: #f28b82;
        }
        .msg-actions .act-btn.danger:hover {
            background: #2a1e1e;
        }
        .msg-actions .act-btn i {
            font-size: 12px;
        }

        .msg-edit-inline {
            display: flex;
            flex-direction: column;
            gap: 6px;
            width: 100%;
        }
        .msg-edit-inline textarea {
            background: #0b0d10;
            border: 1px solid #2f3842;
            border-radius: 8px;
            padding: 8px 12px;
            color: #e8edf2;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            resize: vertical;
            min-height: 50px;
            outline: none;
            width: 100%;
        }
        .msg-edit-inline textarea:focus {
            border-color: #f0c27f;
        }
        .msg-edit-inline .edit-actions {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }
        .msg-edit-inline .edit-actions button {
            padding: 4px 16px;
            border-radius: 16px;
            border: none;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.15s;
        }
        .msg-edit-inline .edit-actions .save-edit {
            background: #f0c27f;
            color: #0b0d10;
        }
        .msg-edit-inline .edit-actions .save-edit:hover {
            background: #e0b06f;
        }
        .msg-edit-inline .edit-actions .cancel-edit {
            background: #1f262e;
            color: #bcc8d6;
        }
        .msg-edit-inline .edit-actions .cancel-edit:hover {
            background: #2c353f;
        }

        .chat-input-area {
            padding: 12px 24px 20px 24px;
            border-top: 1px solid #1a1e24;
            background: #0b0d10;
            flex-shrink: 0;
        }
        .chat-input-wrap {
            display: flex;
            align-items: flex-end;
            gap: 10px;
            background: #13171c;
            border: 1px solid #262c33;
            border-radius: 16px;
            padding: 6px 12px 6px 16px;
            transition: border 0.2s;
        }
        .chat-input-wrap:focus-within {
            border-color: #f0c27f;
        }
        .chat-input-wrap textarea {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            color: #e8edf2;
            font-size: 15px;
            font-family: 'Inter', sans-serif;
            resize: none;
            padding: 8px 0;
            min-height: 24px;
            max-height: 120px;
            line-height: 1.5;
        }
        .chat-input-wrap textarea::placeholder {
            color: #5a6a7a;
        }
        .chat-input-wrap .input-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            padding-bottom: 4px;
        }
        .chat-input-wrap .input-actions button {
            background: transparent;
            border: none;
            color: #7a8a9a;
            font-size: 18px;
            cursor: pointer;
            padding: 6px;
            border-radius: 8px;
            transition: 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
        }
        .chat-input-wrap .input-actions button:hover {
            background: #1f262e;
            color: #e8edf2;
        }
        .chat-input-wrap .input-actions button.send-btn {
            color: #f0c27f;
            font-size: 20px;
        }
        .chat-input-wrap .input-actions button.send-btn:hover {
            background: #2a2218;
            color: #f5d08a;
        }
        .chat-input-wrap .input-actions button.attach-btn {
            color: #7a8a9a;
            font-size: 17px;
        }
        .chat-input-wrap .input-actions button.attach-btn:hover {
            color: #bcc8d6;
        }

        .image-preview-wrap {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 6px 0 4px 0;
        }
        .image-preview-wrap .preview-item {
            position: relative;
            display: inline-block;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid #262c33;
            background: #0b0d10;
            max-width: 120px;
            max-height: 100px;
        }
        .image-preview-wrap .preview-item img {
            display: block;
            width: auto;
            height: auto;
            max-width: 120px;
            max-height: 100px;
            object-fit: contain;
        }
        .image-preview-wrap .preview-item .remove-preview {
            position: absolute;
            top: 2px;
            right: 2px;
            background: rgba(0, 0, 0, 0.7);
            border: none;
            color: #fff;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.15s;
        }
        .image-preview-wrap .preview-item .remove-preview:hover {
            background: rgba(200, 50, 50, 0.85);
        }

        /* ----- MODAL / OVERLAY ----- */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(3px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .modal-overlay.open {
            display: flex;
        }
        .modal-box {
            background: #1a1e24;
            border: 1px solid #2f3842;
            border-radius: 20px;
            padding: 28px 32px 24px 32px;
            max-width: 420px;
            width: 100%;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8);
        }
        .modal-box h3 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 6px;
            color: #e8edf2;
        }
        .modal-box p {
            font-size: 15px;
            color: #b0c0ce;
            margin-bottom: 20px;
            line-height: 1.5;
        }
        .modal-box .modal-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }
        .modal-box .modal-actions button {
            padding: 8px 22px;
            border-radius: 30px;
            border: none;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.15s;
        }
        .modal-box .modal-actions .modal-cancel {
            background: #1f262e;
            color: #bcc8d6;
        }
        .modal-box .modal-actions .modal-cancel:hover {
            background: #2c353f;
        }
        .modal-box .modal-actions .modal-confirm {
            background: #f28b82;
            color: #0b0d10;
        }
        .modal-box .modal-actions .modal-confirm:hover {
            background: #e07a72;
        }
        .modal-box .modal-actions .modal-confirm.gold {
            background: #f0c27f;
        }
        .modal-box .modal-actions .modal-confirm.gold:hover {
            background: #e0b06f;
        }

        .share-options {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 16px 0 10px 0;
        }
        .share-options button {
            background: #1f262e;
            border: none;
            color: #dce4ec;
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.15s;
        }
        .share-options button:hover {
            background: #2c353f;
        }
        .share-options button i {
            font-size: 16px;
        }

        /* ----- WELCOME SCREEN ----- */
        .welcome-screen {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
            text-align: center;
        }
        .welcome-screen .welcome-icon {
            font-size: 72px;
            color: #f0c27f;
            margin-bottom: 16px;
        }
        .welcome-screen h1 {
            font-size: 32px;
            font-weight: 700;
            color: #e8edf2;
            margin-bottom: 8px;
        }
        .welcome-screen p {
            font-size: 18px;
            color: #9aabbb;
            max-width: 480px;
            line-height: 1.6;
        }
        .welcome-screen .sub {
            font-size: 14px;
            color: #6a7a8a;
            margin-top: 20px;
            border-top: 1px solid #1a1e24;
            padding-top: 20px;
            width: 100%;
            max-width: 400px;
        }
        .welcome-screen .sub .brand-credit {
            color: #f0c27f;
            font-weight: 600;
        }

        /* ----- RESPONSIVE ----- */
        @media (max-width: 768px) {
            .sidebar {
                position: fixed;
                left: 0;
                top: 0;
                bottom: 0;
                z-index: 1000;
                transform: translateX(-100%);
                width: 280px;
                box-shadow: 4px 0 30px rgba(0, 0, 0, 0.6);
            }
            .sidebar.open {
                transform: translateX(0);
            }
            .sidebar-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.5);
                z-index: 999;
            }
            .sidebar-backdrop.open {
                display: block;
            }
            .mobile-hamburger {
                display: flex !important;
            }
            .chat-messages {
                padding: 14px 14px 8px 14px;
            }
            .msg {
                max-width: 92%;
                font-size: 14px;
                padding: 10px 14px;
            }
            .chat-input-area {
                padding: 10px 14px 16px 14px;
            }
            .chat-input-wrap {
                padding: 4px 10px 4px 14px;
            }
            .chat-input-wrap textarea {
                font-size: 14px;
            }
            .msg-actions .act-btn {
                font-size: 12px;
                padding: 3px 8px;
            }
            .image-preview-wrap .preview-item {
                max-width: 80px;
                max-height: 70px;
            }
            .image-preview-wrap .preview-item img {
                max-width: 80px;
                max-height: 70px;
            }
            .welcome-screen h1 {
                font-size: 26px;
            }
            .welcome-screen p {
                font-size: 16px;
            }
            .modal-box {
                padding: 20px 18px 18px 18px;
                margin: 10px;
            }
        }

        @media (min-width: 769px) {
            .mobile-hamburger {
                display: none !important;
            }
            .sidebar-backdrop {
                display: none !important;
            }
        }

        .fade-in {
            animation: fadeIn 0.2s ease;
        }
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(6px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .flex-center {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .gap-1 {
            gap: 4px;
        }
        .gap-2 {
            gap: 8px;
        }
        .gap-3 {
            gap: 12px;
        }

        .chat-list {
            scroll-behavior: smooth;
        }

        .toast-message {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            background: #1e252d;
            border: 1px solid #2f3842;
            padding: 10px 24px;
            border-radius: 30px;
            font-size: 14px;
            color: #e8edf2;
            z-index: 99999;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
            animation: fadeIn 0.25s ease;
            pointer-events: none;
            white-space: nowrap;
        }
        .toast-message i {
            margin-right: 8px;
            color: #7ddfa0;
        }
    </style>
</head>
<body>

    <div id="root" class="flex h-screen w-screen overflow-hidden bg-[#0b0d10]">
        <!-- ====== SIDEBACKDROP (mobile) ====== -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- ====== SIDEBAR ====== -->
        <aside class="sidebar" id="sidebar">
            <!-- Header: Brand + Home -->
            <div class="sidebar-header">
                <div class="brand">
                    <i class="fas fa-crown"></i>
                    <span>Dola AI</span>
                </div>
                <button class="home-btn" id="goHomeBtn">
                    <i class="fas fa-house"></i> Home
                </button>
            </div>

            <!-- Recent chats title -->
            <div class="sidebar-title">Recent Chats</div>

            <!-- Chat list -->
            <div class="chat-list" id="chatList">
                <!-- dynamic -->
            </div>

            <!-- mobile close -->
            <div class="p-3 border-t border-[#1a1e24] md:hidden flex justify-center">
                <button id="closeSidebarMobile" class="text-sm text-[#6a7a8a] hover:text-[#bcc8d6]">
                    <i class="fas fa-times mr-2"></i> Close
                </button>
            </div>
        </aside>

        <!-- ====== CHAT AREA ====== -->
        <main class="chat-area" id="chatArea">
            <!-- mobile hamburger -->
            <div class="mobile-hamburger flex items-center p-3 bg-[#0b0d10] border-b border-[#1a1e24] md:hidden">
                <button id="hamburgerBtn" class="text-[#bcc8d6] text-xl p-1">
                    <i class="fas fa-bars"></i>
                </button>
                <span class="ml-3 font-semibold text-[#f0c27f]">Dola AI</span>
            </div>

            <!-- Messages -->
            <div class="chat-messages" id="chatMessages">
                <!-- Welcome screen shown by default -->
                <div class="welcome-screen" id="welcomeScreen">
                    <div class="welcome-icon">
                        <i class="fas fa-crown"></i>
                    </div>
                    <h1>Dola AI</h1>
                    <p>Your intelligent assistant powered by advanced AI.<br />Ask anything, upload images, or generate content.</p>
                    <div class="sub">
                        <span class="brand-credit">👑 Created by IBRAHIM ABDULLAHI — Dola AI 👑</span>
                    </div>
                </div>

                <!-- message container (hidden when welcome shown) -->
                <div id="messageContainer" style="display:none; width:100%;"></div>
            </div>

            <!-- Chat Input -->
            <div class="chat-input-area" id="chatInputArea">
                <!-- Image preview area -->
                <div class="image-preview-wrap" id="imagePreviewWrap"></div>

                <div class="chat-input-wrap">
                    <textarea id="chatInput" rows="1" placeholder="Type your message…" spellcheck="true"></textarea>
                    <div class="input-actions">
                        <button class="attach-btn" id="attachBtn" title="Attach image">
                            <i class="fas fa-image"></i>
                        </button>
                        <button class="send-btn" id="sendBtn" title="Send">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                    <input type="file" id="fileInput" accept="image/jpeg,image/png,image/webp" multiple style="display:none" />
                </div>
            </div>
        </main>
    </div>

    <!-- ====== MODAL ====== -->
    <div class="modal-overlay" id="modalOverlay">
        <div class="modal-box" id="modalBox">
            <h3 id="modalTitle">Confirm</h3>
            <p id="modalDesc">Are you sure?</p>
            <div id="modalBody"></div>
            <div class="modal-actions" id="modalActions">
                <button class="modal-cancel" id="modalCancel">Cancel</button>
                <button class="modal-confirm" id="modalConfirm">Confirm</button>
            </div>
        </div>
    </div>

    <!-- ====== TOAST CONTAINER ====== -->
    <div id="toastContainer"></div>

    <script>
        // ============================================================
        //  DOLA AI — FULL CLIENT
        //  Rebranded from Wise King to Dola AI.
        //  Features: sidebar, chat, image upload, message actions,
        //  rename/delete/share, home, etc.
        // ============================================================

        (function() {
            'use strict';

            // ---- DOM refs ----
            const sidebar = document.getElementById('sidebar');
            const sidebarBackdrop = document.getElementById('sidebarBackdrop');
            const chatList = document.getElementById('chatList');
            const chatMessages = document.getElementById('chatMessages');
            const welcomeScreen = document.getElementById('welcomeScreen');
            const messageContainer = document.getElementById('messageContainer');
            const chatInput = document.getElementById('chatInput');
            const sendBtn = document.getElementById('sendBtn');
            const attachBtn = document.getElementById('attachBtn');
            const fileInput = document.getElementById('fileInput');
            const imagePreviewWrap = document.getElementById('imagePreviewWrap');
            const goHomeBtn = document.getElementById('goHomeBtn');
            const hamburgerBtn = document.getElementById('hamburgerBtn');
            const closeSidebarMobile = document.getElementById('closeSidebarMobile');
            const modalOverlay = document.getElementById('modalOverlay');
            const modalTitle = document.getElementById('modalTitle');
            const modalDesc = document.getElementById('modalDesc');
            const modalBody = document.getElementById('modalBody');
            const modalCancel = document.getElementById('modalCancel');
            const modalConfirm = document.getElementById('modalConfirm');
            const toastContainer = document.getElementById('toastContainer');

            // ---- state ----
            let chats = [];
            let activeChatId = null;
            let nextChatId = 1;
            let nextMsgId = 1;
            let pendingImages = []; // base64 + file objects
            let activeDropdown = null; // chatId
            let editingMsgId = null;
            let renamingChatId = null;

            // ---- helpers ----
            function getTimestamp() {
                const d = new Date();
                return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            }

            function getDateLabel() {
                const d = new Date();
                return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
            }

            function generateId() { return nextMsgId++; }

            function generateChatId() { return nextChatId++; }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function showToast(msg, icon = 'fa-check-circle') {
                const el = document.createElement('div');
                el.className = 'toast-message';
                el.innerHTML = `<i class="fas ${icon}"></i> ${escapeHtml(msg)}`;
                toastContainer.appendChild(el);
                setTimeout(() => {
                    el.style.opacity = '0';
                    el.style.transition = 'opacity 0.3s';
                    setTimeout(() => el.remove(), 350);
                }, 2200);
            }

            // ---- Modal ----
            let modalResolve = null;

            function showModal(title, desc, bodyHTML, confirmText = 'Confirm', confirmGold = false) {
                return new Promise((resolve) => {
                    modalTitle.textContent = title;
                    modalDesc.textContent = desc;
                    modalBody.innerHTML = bodyHTML || '';
                    modalConfirm.textContent = confirmText;
                    modalConfirm.className = 'modal-confirm' + (confirmGold ? ' gold' : '');
                    modalOverlay.classList.add('open');
                    modalResolve = resolve;
                });
            }

            modalCancel.addEventListener('click', () => {
                modalOverlay.classList.remove('open');
                if (modalResolve) { modalResolve(false);
                    modalResolve = null; }
            });
            modalConfirm.addEventListener('click', () => {
                modalOverlay.classList.remove('open');
                if (modalResolve) { modalResolve(true);
                    modalResolve = null; }
            });
            modalOverlay.addEventListener('click', (e) => {
                if (e.target === modalOverlay) {
                    modalOverlay.classList.remove('open');
                    if (modalResolve) { modalResolve(false);
                        modalResolve = null; }
                }
            });

            // ---- Chat data ----
            function createChat(title) {
                return {
                    id: generateChatId(),
                    title: title || 'New Chat',
                    messages: [],
                    createdAt: new Date().toISOString(),
                };
            }

            function addMessage(chatId, text, sender, imageData = null) {
                const chat = chats.find(c => c.id === chatId);
                if (!chat) return null;
                const msg = {
                    id: generateId(),
                    text: text,
                    sender: sender, // 'user' or 'ai'
                    timestamp: getTimestamp(),
                    date: getDateLabel(),
                    image: imageData || null,
                };
                chat.messages.push(msg);
                if (sender === 'user') {
                    if (chat.messages.filter(m => m.sender === 'user').length === 1) {
                        const short = text.length > 40 ? text.slice(0, 40) + '…' : text;
                        chat.title = short;
                    }
                }
                return msg;
            }

            function deleteMessage(chatId, msgId) {
                const chat = chats.find(c => c.id === chatId);
                if (!chat) return false;
                const idx = chat.messages.findIndex(m => m.id === msgId);
                if (idx === -1) return false;
                chat.messages.splice(idx, 1);
                return true;
            }

            function editMessage(chatId, msgId, newText) {
                const chat = chats.find(c => c.id === chatId);
                if (!chat) return false;
                const msg = chat.messages.find(m => m.id === msgId);
                if (!msg || msg.sender !== 'user') return false;
                msg.text = newText;
                return true;
            }

            // ---- Seed initial chat ----
            function seedChats() {
                const chat = createChat('Welcome to Dola AI');
                addMessage(chat.id, 'Hello! I\'m Dola AI. How can I help you today?', 'ai');
                activeChatId = chat.id;
                chats.push(chat);
            }
            seedChats();

            // ---- render sidebar ----
            function renderSidebar() {
                chatList.innerHTML = '';
                chats.forEach(chat => {
                    const item = document.createElement('div');
                    item.className = 'chat-item' + (chat.id === activeChatId ? ' active' : '');
                    item.dataset.chatId = chat.id;

                    const titleSpan = document.createElement('span');
                    titleSpan.className = 'chat-title';
                    const displayTitle = chat.title || 'New Chat';
                    titleSpan.innerHTML =
                        `${escapeHtml(displayTitle)} <span class="date">${chat.messages.length > 0 ? chat.messages[chat.messages.length-1].timestamp : ''}</span>`;

                    const renameDiv = document.createElement('div');
                    renameDiv.className = 'rename-inline';
                    renameDiv.style.display = 'none';
                    const renameInput = document.createElement('input');
                    renameInput.type = 'text';
                    renameInput.value = chat.title || '';
                    renameInput.maxLength = 60;
                    const saveRename = document.createElement('button');
                    saveRename.className = 'rename-btn save';
                    saveRename.innerHTML = '<i class="fas fa-check"></i>';
                    const cancelRename = document.createElement('button');
                    cancelRename.className = 'rename-btn cancel';
                    cancelRename.innerHTML = '<i class="fas fa-times"></i>';
                    renameDiv.appendChild(renameInput);
                    renameDiv.appendChild(saveRename);
                    renameDiv.appendChild(cancelRename);

                    const dotBtn = document.createElement('button');
                    dotBtn.className = 'dot-menu-btn';
                    dotBtn.innerHTML = '⋮';
                    dotBtn.dataset.chatId = chat.id;

                    const dropdown = document.createElement('div');
                    dropdown.className = 'dropdown-menu';
                    dropdown.dataset.chatId = chat.id;
                    const items = [
                        { label: '✏️ Rename Chat', action: 'rename' },
                        { label: '🗑️ Delete Chat', action: 'delete' },
                        { label: '📤 Share', action: 'share' },
                    ];
                    items.forEach(it => {
                        const btn = document.createElement('button');
                        btn.className = 'drop-item' + (it.action === 'delete' ? ' danger' : '');
                        btn.textContent = it.label;
                        btn.dataset.action = it.action;
                        dropdown.appendChild(btn);
                    });

                    const wrapper = document.createElement('div');
                    wrapper.style.cssText = 'display:flex;align-items:center;gap:4px;flex-shrink:0;position:relative;';
                    wrapper.appendChild(dotBtn);
                    wrapper.appendChild(dropdown);

                    const left = document.createElement('div');
                    left.style.cssText = 'display:flex;align-items:center;flex:1;min-width:0;';
                    left.appendChild(titleSpan);
                    left.appendChild(renameDiv);
                    item.appendChild(left);
                    item.appendChild(wrapper);

                    item.addEventListener('click', (e) => {
                        if (e.target.closest('.dot-menu-btn') || e.target.closest('.dropdown-menu') || e.target
                            .closest('.rename-inline')) return;
                        switchChat(chat.id);
                        closeAllDropdowns();
                        closeSidebarMobileFn();
                    });

                    dotBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const cid = parseInt(dotBtn.dataset.chatId);
                        toggleDropdown(cid);
                    });

                    dropdown.querySelectorAll('.drop-item').forEach(btn => {
                        btn.addEventListener('click', (e) => {
                            e.stopPropagation();
                            const action = btn.dataset.action;
                            const cid = parseInt(dropdown.dataset.chatId);
                            handleDropdownAction(cid, action);
                        });
                    });

                    saveRename.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const newTitle = renameInput.value.trim();
                        if (newTitle) {
                            const chat = chats.find(c => c.id === chat.id);
                            if (chat) {
                                chat.title = newTitle;
                                renamingChatId = null;
                                renderSidebar();
                                renderChat();
                                showToast('Chat renamed!');
                            }
                        }
                    });
                    cancelRename.addEventListener('click', (e) => {
                        e.stopPropagation();
                        renamingChatId = null;
                        renderSidebar();
                    });
                    renameInput.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter') { saveRename.click(); }
                        if (e.key === 'Escape') { cancelRename.click(); }
                    });

                    chatList.appendChild(item);

                    if (renamingChatId === chat.id) {
                        titleSpan.style.display = 'none';
                        renameDiv.style.display = 'flex';
                        setTimeout(() => renameInput.focus(), 50);
                    }
                });
            }

            // ---- dropdown ----
            function toggleDropdown(chatId) {
                closeAllDropdowns();
                if (activeDropdown === chatId) {
                    activeDropdown = null;
                    return;
                }
                const dropdown = document.querySelector(`.dropdown-menu[data-chat-id="${chatId}"]`);
                if (dropdown) {
                    dropdown.classList.add('open');
                    activeDropdown = chatId;
                    const wrapper = dropdown.closest('.chat-item').querySelector('.dot-menu-btn');
                    if (wrapper) {
                        const rect = wrapper.getBoundingClientRect();
                        dropdown.style.top = '36px';
                        dropdown.style.right = '0';
                    }
                }
            }

            function closeAllDropdowns() {
                document.querySelectorAll('.dropdown-menu.open').forEach(el => el.classList.remove('open'));
                activeDropdown = null;
            }

            document.addEventListener('click', (e) => {
                if (!e.target.closest('.dropdown-menu') && !e.target.closest('.dot-menu-btn')) {
                    closeAllDropdowns();
                }
            });

            // ---- handle dropdown actions ----
            async function handleDropdownAction(chatId, action) {
                closeAllDropdowns();
                const chat = chats.find(c => c.id === chatId);
                if (!chat) return;

                if (action === 'rename') {
                    renamingChatId = chatId;
                    renderSidebar();
                    return;
                }

                if (action === 'delete') {
                    const ok = await showModal(
                        'Delete Chat',
                        `Are you sure you want to delete "${chat.title || 'Untitled'}"? This cannot be undone.`,
                        '',
                        'Delete',
                        false
                    );
                    if (ok) {
                        const idx = chats.findIndex(c => c.id === chatId);
                        if (idx !== -1) {
                            chats.splice(idx, 1);
                            if (activeChatId === chatId) {
                                if (chats.length > 0) {
                                    activeChatId = chats[0].id;
                                } else {
                                    const newChat = createChat('New Chat');
                                    addMessage(newChat.id, 'Hello! I\'m Dola AI. How can I help you today?', 'ai');
                                    chats.push(newChat);
                                    activeChatId = newChat.id;
                                }
                            }
                            renderSidebar();
                            renderChat();
                            showToast('Chat deleted.');
                        }
                    }
                    return;
                }

                if (action === 'share') {
                    const shareHTML = `
                        <div class="share-options">
                            <button data-share="whatsapp"><i class="fab fa-whatsapp"></i> WhatsApp</button>
                            <button data-share="facebook"><i class="fab fa-facebook"></i> Facebook</button>
                            <button data-share="tiktok"><i class="fab fa-tiktok"></i> TikTok</button>
                            <button data-share="instagram"><i class="fab fa-instagram"></i> Instagram</button>
                            <button data-share="copy"><i class="fas fa-link"></i> Copy Link</button>
                        </div>
                    `;
                    await showModal('Share Chat', `Share "${chat.title || 'Untitled'}" with others:`, shareHTML, 'Close', true);
                    const shareBtns = document.querySelectorAll('.share-options button');
                    shareBtns.forEach(btn => {
                        btn.onclick = (e) => {
                            e.stopPropagation();
                            const platform = btn.dataset.share;
                            const url = window.location.href;
                            const text = `Check out my chat: "${chat.title}" on Dola AI!`;
                            let shareUrl = '';
                            if (platform === 'whatsapp') shareUrl =
                                `https://wa.me/?text=${encodeURIComponent(text + ' ' + url)}`;
                            else if (platform === 'facebook') shareUrl =
                                `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}&quote=${encodeURIComponent(text)}`;
                            else if (platform === 'tiktok') shareUrl =
                                `https://www.tiktok.com/@?text=${encodeURIComponent(text)}`;
                            else if (platform === 'instagram') shareUrl =
                                `https://www.instagram.com/?url=${encodeURIComponent(url)}`;
                            else if (platform === 'copy') {
                                navigator.clipboard.writeText(url + ' | ' + text).then(() => {
                                    showToast('Link copied!');
                                }).catch(() => {
                                    const ta = document.createElement('textarea');
                                    ta.value = url + ' | ' + text;
                                    document.body.appendChild(ta);
                                    ta.select();
                                    document.execCommand('copy');
                                    ta.remove();
                                    showToast('Link copied!');
                                });
                                return;
                            }
                            if (shareUrl) window.open(shareUrl, '_blank');
                            modalOverlay.classList.remove('open');
                        };
                    });
                    return;
                }
            }

            // ---- switch chat ----
            function switchChat(chatId) {
                activeChatId = chatId;
                renderSidebar();
                renderChat();
                closeAllDropdowns();
            }

            // ---- render chat ----
            function renderChat() {
                const chat = chats.find(c => c.id === activeChatId);
                if (!chat) {
                    welcomeScreen.style.display = 'flex';
                    messageContainer.style.display = 'none';
                    return;
                }

                welcomeScreen.style.display = 'none';
                messageContainer.style.display = 'block';
                messageContainer.innerHTML = '';

                chat.messages.forEach(msg => {
                    const div = document.createElement('div');
                    div.className = `msg ${msg.sender}`;
                    div.dataset.msgId = msg.id;

                    let content = '';
                    if (msg.image) {
                        content +=
                            `<img src="${msg.image}" class="msg-image" alt="uploaded" onclick="window.open('${msg.image}','_blank')" />`;
                    }
                    if (msg.text) {
                        content += `<div class="msg-text">${escapeHtml(msg.text)}</div>`;
                    }
                    content += `<span class="msg-time">${msg.timestamp}</span>`;
                    div.innerHTML = content;

                    const actions = document.createElement('div');
                    actions.className = 'msg-actions';

                    if (msg.sender === 'user') {
                        const editBtn = document.createElement('button');
                        editBtn.className = 'act-btn edit';
                        editBtn.innerHTML = '<i class="fas fa-pen"></i> Edit';
                        editBtn.addEventListener('click', (e) => {
                            e.stopPropagation();
                            startEditMessage(chat.id, msg.id);
                        });
                        actions.appendChild(editBtn);
                    }

                    const copyBtn = document.createElement('button');
                    copyBtn.className = 'act-btn';
                    copyBtn.innerHTML = '<i class="fas fa-copy"></i> Copy';
                    copyBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const text = msg.text || '';
                        navigator.clipboard.writeText(text).then(() => {
                            showToast('Copied!');
                        }).catch(() => {
                            const ta = document.createElement('textarea');
                            ta.value = text;
                            document.body.appendChild(ta);
                            ta.select();
                            document.execCommand('copy');
                            ta.remove();
                            showToast('Copied!');
                        });
                    });
                    actions.appendChild(copyBtn);

                    const delBtn = document.createElement('button');
                    delBtn.className = 'act-btn danger';
                    delBtn.innerHTML = '<i class="fas fa-trash"></i> Delete';
                    delBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        confirmDeleteMessage(chat.id, msg.id);
                    });
                    actions.appendChild(delBtn);

                    div.appendChild(actions);
                    messageContainer.appendChild(div);
                });

                const container = document.getElementById('chatMessages');
                container.scrollTop = container.scrollHeight;
            }

            // ---- edit message inline ----
            function startEditMessage(chatId, msgId) {
                const chat = chats.find(c => c.id === chatId);
                if (!chat) return;
                const msg = chat.messages.find(m => m.id === msgId);
                if (!msg || msg.sender !== 'user') return;

                const msgEl = document.querySelector(`.msg[data-msg-id="${msgId}"]`);
                if (!msgEl) return;

                const currentText = msg.text || '';
                const wrap = document.createElement('div');
                wrap.className = 'msg-edit-inline';
                wrap.innerHTML = `
                    <textarea>${escapeHtml(currentText)}</textarea>
                    <div class="edit-actions">
                        <button class="cancel-edit">Cancel</button>
                        <button class="save-edit">Save</button>
                    </div>
                `;
                const textDiv = msgEl.querySelector('.msg-text');
                const timeSpan = msgEl.querySelector('.msg-time');
                const imgEl = msgEl.querySelector('.msg-image');
                if (textDiv) textDiv.style.display = 'none';
                if (timeSpan) timeSpan.style.display = 'none';
                if (imgEl) imgEl.style.display = 'none';
                msgEl.querySelector('.msg-actions').style.display = 'none';

                const editWrap = document.createElement('div');
                editWrap.className = 'msg-edit-wrap';
                editWrap.appendChild(wrap);
                msgEl.appendChild(editWrap);

                const textarea = wrap.querySelector('textarea');
                const saveBtn = wrap.querySelector('.save-edit');
                const cancelBtn = wrap.querySelector('.cancel-edit');

                textarea.focus();
                textarea.setSelectionRange(textarea.value.length, textarea.value.length);

                const finishEdit = (save) => {
                    if (save) {
                        const newText = textarea.value.trim();
                        if (newText && newText !== currentText) {
                            editMessage(chatId, msgId, newText);
                            showToast('Message updated.');
                        } else if (!newText) {
                            showToast('Message cannot be empty.', 'fa-exclamation-circle');
                            return;
                        }
                    }
                    renderChat();
                };

                saveBtn.addEventListener('click', () => finishEdit(true));
                cancelBtn.addEventListener('click', () => finishEdit(false));
                textarea.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') finishEdit(false);
                    if (e.key === 'Enter' && e.ctrlKey) finishEdit(true);
                });
            }

            // ---- confirm delete message ----
            async function confirmDeleteMessage(chatId, msgId) {
                const ok = await showModal(
                    'Delete Message',
                    'Delete this message?',
                    '',
                    'Delete',
                    false
                );
                if (ok) {
                    if (deleteMessage(chatId, msgId)) {
                        renderChat();
                        showToast('Message deleted.');
                    }
                }
            }

            // ---- send message ----
            async function sendMessage() {
                const text = chatInput.value.trim();
                const hasImages = pendingImages.length > 0;
                if (!text && !hasImages) return;

                const chat = chats.find(c => c.id === activeChatId);
                if (!chat) return;

                let imageData = null;
                if (pendingImages.length > 0) {
                    imageData = pendingImages[0].data;
                }

                const userMsg = addMessage(activeChatId, text || '📸 Image', 'user', imageData);
                pendingImages = [];
                renderChat();
                updateImagePreview();
                chatInput.value = '';
                chatInput.style.height = 'auto';

                // AI response — now branded as Dola AI
                const aiReply = generateAIReply(text, imageData);
                setTimeout(() => {
                    addMessage(activeChatId, aiReply, 'ai');
                    renderChat();
                    renderSidebar();
                }, 400 + Math.random() * 400);
            }

            // ---- generate AI reply (mock, branded Dola AI) ----
            function generateAIReply(userText, imageData) {
                let reply = '';
                if (imageData) {
                    reply += '📷 I see your image! ';
                }
                if (userText) {
                    reply += `You said: "${userText}". `;
                }
                if (!userText && imageData) {
                    reply += 'That\'s a nice picture! What would you like to know about it?';
                } else if (userText && imageData) {
                    reply += 'Let me think about that and get back to you with a helpful response.';
                } else {
                    reply = 'Thanks for your message! How can I assist you further?';
                }
                // Add Dola AI branding
                reply += ' — Dola AI is here to help!';
                // Hausa touch
                if (Math.random() > 0.6) {
                    reply += ' Na gode! (Thank you!)';
                }
                return reply;
            }

            // ---- image upload ----
            attachBtn.addEventListener('click', () => {
                fileInput.click();
            });

            fileInput.addEventListener('change', (e) => {
                const files = e.target.files;
                if (!files || files.length === 0) return;
                for (const file of files) {
                    if (!file.type.startsWith('image/')) continue;
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        const data = ev.target.result;
                        pendingImages.push({
                            data: data,
                            file: file,
                            name: file.name,
                        });
                        updateImagePreview();
                    };
                    reader.readAsDataURL(file);
                }
                fileInput.value = '';
            });

            function updateImagePreview() {
                imagePreviewWrap.innerHTML = '';
                pendingImages.forEach((img, idx) => {
                    const div = document.createElement('div');
                    div.className = 'preview-item';
                    const imgEl = document.createElement('img');
                    imgEl.src = img.data;
                    imgEl.alt = img.name || 'preview';
                    const removeBtn = document.createElement('button');
                    removeBtn.className = 'remove-preview';
                    removeBtn.innerHTML = '×';
                    removeBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        pendingImages.splice(idx, 1);
                        updateImagePreview();
                    });
                    div.appendChild(imgEl);
                    div.appendChild(removeBtn);
                    imagePreviewWrap.appendChild(div);
                });
                if (pendingImages.length === 0) {
                    imagePreviewWrap.style.display = 'none';
                } else {
                    imagePreviewWrap.style.display = 'flex';
                }
            }
            updateImagePreview();

            // ---- send on enter ----
            chatInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            sendBtn.addEventListener('click', sendMessage);

            // ---- go home ----
            goHomeBtn.addEventListener('click', () => {
                welcomeScreen.style.display = 'flex';
                messageContainer.style.display = 'none';
                if (chats.length === 0) {
                    const chat = createChat('New Chat');
                    addMessage(chat.id, 'Hello! I\'m Dola AI. How can I help you today?', 'ai');
                    chats.push(chat);
                    activeChatId = chat.id;
                } else {
                    activeChatId = chats[0].id;
                }
                renderSidebar();
                renderChat();
                closeAllDropdowns();
                closeSidebarMobileFn();
                showToast('Welcome back!');
            });

            // ---- sidebar mobile ----
            function toggleSidebar(open) {
                if (open) {
                    sidebar.classList.add('open');
                    sidebarBackdrop.classList.add('open');
                } else {
                    sidebar.classList.remove('open');
                    sidebarBackdrop.classList.remove('open');
                }
            }

            function closeSidebarMobileFn() {
                if (window.innerWidth <= 768) {
                    toggleSidebar(false);
                }
            }

            hamburgerBtn.addEventListener('click', () => {
                toggleSidebar(true);
            });
            closeSidebarMobile.addEventListener('click', closeSidebarMobileFn);
            sidebarBackdrop.addEventListener('click', closeSidebarMobileFn);

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    closeAllDropdowns();
                    closeSidebarMobileFn();
                    if (renamingChatId) {
                        renamingChatId = null;
                        renderSidebar();
                    }
                }
            });

            // ---- auto-resize textarea ----
            chatInput.addEventListener('input', () => {
                chatInput.style.height = 'auto';
                chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';
            });

            // ---- init ----
            renderSidebar();
            renderChat();

            document.addEventListener('click', (e) => {
                if (!e.target.closest('.dropdown-menu') && !e.target.closest('.dot-menu-btn')) {
                    closeAllDropdowns();
                }
            });

            document.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.key === 'Home') {
                    e.preventDefault();
                    goHomeBtn.click();
                }
            });

            if (chats.length === 0) {
                const chat = createChat('New Chat');
                addMessage(chat.id, 'Hello! I\'m Dola AI. How can I help you today?', 'ai');
                chats.push(chat);
                activeChatId = chat.id;
                renderSidebar();
                renderChat();
            }

            console.log('👑 Dola AI loaded successfully!');
            console.log('📸 Image upload, message actions, sidebar all ready.');
            console.log('💡 Tip: Ctrl+Home to go back to welcome.');

        })();
    </script>
</body>
</html>
